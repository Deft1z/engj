<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.IamSyncLogMapper">

    <resultMap id="IamSyncLogResult" type="com.kge.energy.crm.repository.entityext.result.IamSyncLogResult">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="syncTime" column="sync_time" jdbcType="VARCHAR"/>
        <result property="syncName" column="sync_name" jdbcType="VARCHAR"/>
        <result property="syncContent" column="sync_content" jdbcType="VARCHAR"/>
        <result property="syncResult" column="sync_result" jdbcType="VARCHAR"/>
        <result property="successFlag" column="success_flag" jdbcType="BOOLEAN"/>
    </resultMap>

    <!-- 用于select查询公用抽取的列 -->
    <sql id="columns">
        id, sync_time, sync_name, sync_content, sync_result, success_flag
    </sql>

    <delete id="deleteHisLogs">
        delete from iam_sync_log
        where sync_time &lt;= #{syncTime}
    </delete>

</mapper>

