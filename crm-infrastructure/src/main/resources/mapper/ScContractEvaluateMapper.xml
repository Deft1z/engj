<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.ScContractEvaluateMapper">

    <resultMap type="com.kge.energy.crm.repository.entity.ScContractEvaluate" id="ScContractEvaluateMap">
        <result property="contractEvaluateId" column="contract_evaluate_id" jdbcType="INTEGER"/>
        <result property="serviceContractId" column="service_contract_id" jdbcType="INTEGER"/>
        <result property="satisfaction" column="satisfaction" jdbcType="INTEGER"/>
        <result property="evaluate" column="evaluate" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="getStartEva" resultType="com.kge.energy.crm.repository.entityext.result.StartEva">
        SELECT
            count(if(s.satisfaction = #{star}, 1, null)) as star_num,
            count(if(s.satisfaction = #{star}, 1, null))*100/count(if(s.satisfaction > 0, 1, null)) as rate
        FROM
            sc_contract_evaluate s
    </select>

    <select id="getAverage" resultType="java.lang.Float">
        SELECT
            (
                1 * count(
                        IF
                        ( s.satisfaction = 1, 1, NULL ))+ 2 * count(
                        IF
                        ( s.satisfaction = 2, 1, NULL ))+ 3 * count(
                        IF
                        ( s.satisfaction = 3, 1, NULL )) + 4 * count(
                        IF
                        ( s.satisfaction = 4, 1, NULL ))+ 5 * count(
                        IF
                        ( s.satisfaction = 5, 1, NULL )))/ count(
                    IF
                    ( s.satisfaction > 0, 1, NULL )) AS average
        FROM
            sc_contract_evaluate s
    </select>

</mapper>

