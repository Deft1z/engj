<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.RUserLikeCommentMapper">

    <resultMap type="com.kge.energy.crm.repository.entity.RUserLikeComment" id="RUserLikeCommentMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="commentId" column="comment_id" jdbcType="INTEGER"/>
        <result property="userId" column="user_id" jdbcType="INTEGER"/>
        <result property="flag" column="flag" jdbcType="INTEGER"/>
        <result property="createUserId" column="create_user_id" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="modifyUserId" column="modify_user_id" jdbcType="INTEGER"/>
        <result property="modifyTime" column="modify_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="findThumbsUp" resultMap="RUserLikeCommentMap">
        select * from r_user_like_comment
        where comment_id = #{param.commentId}
        and user_id = #{param.userId}
        <if test="param.flag != null">
            and flag = #{param.flag}
        </if>
    </select>

    <update id="thumbsUp2">
        update r_user_like_comment
        set flag = 1
        where comment_id = #{param.commentId}
        and user_id = #{param.userId}
        and flag = 0
    </update>

</mapper>

