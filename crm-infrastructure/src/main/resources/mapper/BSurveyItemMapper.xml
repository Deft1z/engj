<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.BSurveyItemMapper">

    <resultMap id="BSurveyItemResult" type="com.kge.energy.crm.repository.entityext.result.BSurveyItemResult">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="surveyId" column="survey_id" jdbcType="INTEGER"/>
        <result property="itemCode" column="item_code" jdbcType="VARCHAR"/>
        <result property="itemName" column="item_name" jdbcType="VARCHAR"/>
        <result property="itemType" column="item_type" jdbcType="VARCHAR"/>
        <result property="parentId" column="parent_id" jdbcType="INTEGER"/>
        <result property="priority" column="priority" jdbcType="INTEGER"/>
        <result property="fillBy" column="fill_by" jdbcType="VARCHAR"/>
        <result property="createUserId" column="create_user_id" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="modifyUserId" column="modify_user_id" jdbcType="INTEGER"/>
        <result property="modifyTime" column="modify_time" jdbcType="TIMESTAMP"/>
        <result property="flag" column="flag" jdbcType="INTEGER"/>
        <result property="tenantId" column="tenant_id" jdbcType="INTEGER"/>
        <collection property="fillOptions" ofType="com.kge.energy.crm.repository.entityext.result.BSurveyItemOptionResult"
                    column="{itemId=id}" select="com.kge.energy.crm.repository.mapper.BSurveyItemOptionMapper.getByItemId"/>
        <collection property="subItems" ofType="com.kge.energy.crm.repository.entityext.result.BSurveyItemResult"
                    column="{parentId=id}" select="getByParentId"/>
    </resultMap>

    <!-- 用于select查询公用抽取的列 -->
    <sql id="columns">
        id, survey_id, item_code, item_name, item_type, parent_id, priority, fill_by, create_user_id, create_time, modify_user_id, modify_time, flag, tenant_id
    </sql>

    <select id="getBySurveyId" resultMap="BSurveyItemResult">
        select *
        from b_survey_item
        where flag = 1
        and parent_id is null
        and survey_id = #{surveyId}
        order by priority
    </select>

    <select id="getByParentId" resultMap="BSurveyItemResult">
        select *
        from b_survey_item
        where flag = 1
          and parent_id = #{parentId}
        order by priority
    </select>

</mapper>

