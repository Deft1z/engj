<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.SysOperateLogMapper">
    <resultMap type="com.kge.energy.crm.repository.entity.SysOperateLog" id="SysOperateLogMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="traceId" column="trace_id" jdbcType="VARCHAR"/>
        <result property="tenantId" column="tenant_id" jdbcType="INTEGER"/>
        <result property="tenantName" column="tenant_name" jdbcType="VARCHAR"/>
        <result property="operatorId" column="operator_id" jdbcType="INTEGER"/>
        <result property="operatorName" column="operator_name" jdbcType="VARCHAR"/>
        <result property="operateTime" column="operate_time" jdbcType="TIMESTAMP"/>
        <result property="operateModule" column="operate_module" jdbcType="INTEGER"/>
        <result property="operateBehavior" column="operate_behavior" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="list" resultMap="SysOperateLogMap">
        select *
        from sys_operate_log
        <if test="param.tenantId != null">
            and tenant_id = #{param.tenantId}
        </if>
        <if test="param.operateModule != null">
            and operate_module = #{param.operateModule}
        </if>
        <if test="param.operatorName != null and param.operatorName != ''">
            and operator_name like CONCAT('%',#{param.operatorName},'%')
        </if>
        order by id desc
    </select>
</mapper>

