<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.OmReportMapper">

    <resultMap type="com.kge.energy.crm.repository.entity.OmReport" id="OmReportMap">
        <result property="reportId" column="report_id" jdbcType="INTEGER"/>
        <result property="formId" column="form_id" jdbcType="INTEGER"/>
        <result property="serviceCode" column="service_code" jdbcType="VARCHAR"/>
        <result property="patrolRecordCode" column="patrol_record_code" jdbcType="VARCHAR"/>
        <result property="reportFileId" column="report_file_id" jdbcType="INTEGER"/>
        <result property="reportResult" column="report_result" jdbcType="INTEGER"/>
        <result property="operator" column="operator" jdbcType="VARCHAR"/>
        <result property="operationTime" column="operation_time" jdbcType="TIMESTAMP"/>
        <result property="flag" column="flag" jdbcType="INTEGER"/>
        <result property="createUserId" column="create_user_id" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="modifyUserId" column="modify_user_id" jdbcType="INTEGER"/>
        <result property="modifyTime" column="modify_time" jdbcType="TIMESTAMP"/>
        <result property="remark" column="remark" jdbcType="VARCHAR"/>
        <result property="reportFileName" column="report_file_name" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="getList" resultMap="OmReportMap">
        select *
        from om_report
        where operator = #{operator}
    </select>

</mapper>

