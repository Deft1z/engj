<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kge.energy.crm.repository.mapper.CfBizFunctionMapper">

    <resultMap type="com.kge.energy.crm.repository.entity.CfBizFunction" id="CfBizFunctionMap">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="moduleName" column="module_name" jdbcType="VARCHAR"/>
        <result property="moduleCode" column="module_code" jdbcType="VARCHAR"/>
        <result property="functionName" column="function_name" jdbcType="VARCHAR"/>
        <result property="functionCode" column="function_code" jdbcType="VARCHAR"/>
        <result property="flag" column="flag" jdbcType="INTEGER"/>
        <result property="createUserId" column="create_user_id" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="modifyUserId" column="modify_user_id" jdbcType="INTEGER"/>
        <result property="modifyTime" column="modify_time" jdbcType="TIMESTAMP"/>
        <result property="tenantId" column="tenant_id" jdbcType="INTEGER"/>
    </resultMap>

    <select id="list" resultMap="CfBizFunctionMap">
        select *
        from cf_biz_function
        where flag = 1
        <if test="param.tenantId != null">
            and tenant_id = #{param.tenantId}
        </if>
        <if test="param.moduleName != null and param.moduleName != ''">
            and module_name like CONCAT('%',#{param.moduleName},'%')
        </if>
        <if test="param.moduleCode != null and param.moduleCode != ''">
            and module_code like CONCAT('%',#{param.moduleCode},'%')
        </if>
        <if test="param.functionName != null and param.functionName != ''">
            and function_name like CONCAT('%',#{param.functionName},'%')
        </if>
        <if test="param.functionCode != null and param.functionCode != ''">
            and function_code like CONCAT('%',#{param.functionCode},'%')
        </if>
        order by id asc
    </select>
</mapper>

